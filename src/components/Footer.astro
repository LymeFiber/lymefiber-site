---
import wordmark from '../assets/wordmark-reverse.svg?raw';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getDocuments, getSettings } from '../lib/data';
const s = getSettings();
// Policy links come from the Documents list in the site editor, matched by title.
// A link is left out if that document is missing or its PDF hasn't been uploaded.
const policies = [
  ['Subscriber Agreement', /subscriber agreement/i],
  ['Privacy Policy', /privacy policy/i],
  ['Acceptable Use Policy', /acceptable use/i],
].flatMap(([label, re]) => {
  const d = getDocuments().find((d) => (re as RegExp).test(d.title));
  return d && existsSync(join(process.cwd(), 'public', d.file)) ? [{ label: label as string, href: d.file }] : [];
});
const tel = (n: string) => `tel:${n.replace(/[^0-9+]/g, '')}`;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="wordmark wordmark--reverse" href="/" set:html={wordmark} />
      <p>Community-focused fiber internet for Lyme, Orford &amp; Hanover.</p>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={tel(s.support_phone)}>{s.support_phone}</a></li>
        <li>Toll free: <a href={tel(s.tollfree_phone)}>{s.tollfree_phone}</a></li>
        <li><a href={`mailto:${s.support_email}`}>{s.support_email}</a></li>
        <li>{s.postal_address}</li>
      </ul>
    </div>
    <div>
      <h2>Resources</h2>
      <ul>
        <li><a href="/support/faq/">FAQ</a></li>
        <li><a href="/connect/installation/">Installation &amp; Scheduling</a></li>
        <li><a href="/documents/">Policies &amp; Documents</a></li>
        <li><a href="/support/contact/">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h2>Policies</h2>
      <ul>
        {policies.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        <li><a href="/terms/">Website Terms of Use</a></li>
      </ul>
    </div>
  </div>
  <p class="site-footer__copy">© {year} {s.copyright_name}</p>
</footer>
