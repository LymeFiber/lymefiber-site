---
import '../styles/global.css';
import NoticeBanner from '../components/NoticeBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Notice } from '../lib/schemas';
import type { Crumb } from '../lib/breadcrumbs';

interface Props {
  title: string;
  description?: string;
  permalink: string;
  notice?: Notice;
  breadcrumbs?: Crumb[];
  bodyClass?: string;
}
const { title, description = '', permalink, notice, breadcrumbs = [], bodyClass } = Astro.props;
const site = Astro.site ?? new URL('https://lymefiber.net');
const canonical = new URL(permalink, site).href;
const ogImage = new URL('/og-image.png', site).href;
const fullTitle = permalink === '/' ? `LymeFiber | ${title}` : `${title} | LymeFiber`;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/SortsMillGoudy-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LymeFiber" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#004f3e" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <NoticeBanner notice={notice} />
    <Header permalink={permalink} />
    <main id="main">
      <Breadcrumbs crumbs={breadcrumbs} />
      <slot />
    </main>
    <Footer />
  </body>
</html>
