---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
import LabelsTable from '../components/LabelsTable.astro';
import { getSettings } from '../lib/data';
import { replaceTokensInHtml, warnUnknown } from '../lib/tokens';
import { breadcrumbsFor } from '../lib/breadcrumbs';
import { selectPages } from '../lib/pages';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  const { kept, skipped } = selectPages(all.map((page) => ({ id: page.id, permalink: page.data.permalink, page })));
  for (const s of skipped) console.warn(`[pages] ${s.id} uses ${s.permalink}, which belongs to ${s.keptId}; skipping`);
  const titles = Object.fromEntries(kept.map(({ page }) => [page.data.permalink, page.data.title]));
  return kept.map(({ page, permalink }) => ({
    params: { slug: permalink === '/' ? undefined : permalink.slice(1, -1) },
    props: { page, titles },
  }));
}

interface Props { page: CollectionEntry<'pages'>; titles: Record<string, string> }
const { page, titles } = Astro.props;
const { title, description, permalink, labels_csv } = page.data;
// The page at "/" is always the home page, so a CMS save can never change its layout.
const layout = permalink === '/' ? 'home' : page.data.layout;

const { text, unknown } = replaceTokensInHtml(page.rendered?.html ?? '', getSettings());
warnUnknown(unknown, page.id);
const body = text.replace(/<table/g, '<div class="table-scroll"><table').replace(/<\/table>/g, '</table></div>');
const crumbs = breadcrumbsFor(permalink, (p) => titles[p]);
---
{layout === 'home' ? (
  <HomeLayout title={title} description={description} permalink={permalink}>
    <Fragment set:html={body} />
  </HomeLayout>
) : (
  <BaseLayout title={title} description={description} permalink={permalink} breadcrumbs={crumbs}>
    <article class="page">
      <h1>{title}</h1>
      <Fragment set:html={body} />
      {labels_csv && <LabelsTable csvPath={labels_csv} />}
    </article>
  </BaseLayout>
)}
