  "title": {
    "rendered": "LymeFiber Policies"
  },
  "content": {
    "rendered": "\n\n\t<p>LymeFiber DMCA</p>\n\t\t\t\t<a href=\"https://www.lymefiber.net/wp-content/uploads/2021/08/LymeFiber-DMCA-Policy-.pdf\" target=\"_self\" itemprop=\"url\" rel=\"noopener\">\n\t\t\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https://www.lymefiber.net/wp-content/uploads/2021/08/Lymefiber-DCMA-Policy-232x300.jpg\" alt=\"Lymefiber-DCMA-Policy\" itemprop=\"image\" height=\"300\" width=\"232\" title=\"Lymefiber-DCMA-Policy\" onerror=\"this.style.display='none'\"  />\n\t\t\t\t</a>\n\t<p>Subscriber Agreement</p>\n\t\t\t\t<a href=\"https://www.lymefiber.net/wp-content/uploads/2020/11/LymeFiber_Subscriber_Agreement_and_Terms-01_01_2022.pdf\" target=\"_self\" itemprop=\"url\" rel=\"noopener\">\n\t\t\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https://www.lymefiber.net/wp-content/uploads/2021/08/LymeFiber-Subscriber-Agreement-Photo-230x300.png\" alt=\"LymeFiber Subscriber Agreement Photo\" itemprop=\"image\" height=\"300\" width=\"230\" title=\"LymeFiber Subscriber Agreement Photo\" onerror=\"this.style.display='none'\"  />\n\t\t\t\t</a>\n\t<p>Open Internet Transparency Policy</p>\n\t\t\t\t<a href=\"https://www.lymefiber.net/lymefiber-dmca-policy/\" target=\"_self\" itemprop=\"url\" rel=\"noopener\">\n\t\t\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https://www.lymefiber.net/wp-content/uploads/2022/01/lymefiber-open-internet-policy--264x300.png\" alt=\"lymefiber open internet policy\" itemprop=\"image\" height=\"300\" width=\"264\" title=\"lymefiber open internet policy\" onerror=\"this.style.display='none'\"  />\n\t\t\t\t</a>\n\t<p>Privacy Policy</p>\n\t\t\t\t<a href=\"https://www.lymefiber.net/privacy-policy/\" target=\"_self\" itemprop=\"url\" rel=\"noopener\">\n\t\t\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https://www.lymefiber.net/wp-content/uploads/2022/01/LymeFiber-Privacy-Policy-Image--234x300.png\" alt=\"LymeFiber Privacy Policy Image\" itemprop=\"image\" height=\"300\" width=\"234\" title=\"LymeFiber Privacy Policy Image\" onerror=\"this.style.display='none'\"  />\n\t\t\t\t</a>\n\t<p>ACCEPTABLE USE POLICY</p>\n\t\t\t\t<a href=\"https://www.lymefiber.net/privacy-policy/\" target=\"_self\" itemprop=\"url\" rel=\"noopener\">\n\t\t\t\t<img loading=\"lazy\" decoding=\"async\" src=\"https://www.lymefiber.net/wp-content/uploads/2022/01/LymeFiber-Acceptable-Use-Policy-Image-1-1-232x300.png\" alt=\"LymeFiber-Acceptable-Use-Policy-Image-1-1\" itemprop=\"image\" height=\"300\" width=\"232\" title=\"LymeFiber-Acceptable-Use-Policy-Image-1-1\" onerror=\"this.style.display='none'\"  />\n\t\t\t\t</a>\n\n",
    "protected": false
  },
  "excerpt": {
