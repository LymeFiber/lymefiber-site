  "title": {
    "rendered": "Sign Up For LymeFiber Services!"
  },
  "content": {
    "rendered": "<div class=\"signup-form\">Please complete the signup form as well as you can (it&#8217;s pretty self-explanatory). At the end of the form, we provide a comment box where you can ask questions or pass on instructions.Please note that there&#8217;s no obligation now, and only a month-to-month agreement once we start your service. By completing this subscription form you are agreeing to let LymeFiber staff on your property to conduct the initial survey.</p>\n</div>\n",
    "protected": false
  },
