  "content": {
    "rendered": "\n\n\t<iframe loading=\"lazy\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3422.8201004160815!2d-72.58474327070377!3d43.83018045767306!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cb4d84397e501bf%3A0x51ae202362d5e4b9!2s415+Waterman+Rd%2C+South+Royalton%2C+VT+05068!5e0!3m2!1sen!2sus!4v1549917764375\" width=\"99%\" height=\"300\" frameborder=\"0\" allowfullscreen></iframe>\n\t<p><strong>LymeFiber Customer Service</strong></p>\n<i>P.O. Box 323,</i> South Royalton, VT 05068<br />\n<a href=\"tel:(833)-795-5300\">(833)-795-5300</a><br />\n<a href=\"mailto:support@notices.lymefiber.net\">Support@Notices.LymeFiber.net</a>\n<p>Office hours: Monday &#8211; Friday, 9am-5pm</p>\n\n",
    "protected": false
  },
  "excerpt": {
    "rendered": "<p>LymeFiber Customer Service P.O. Box 323, South Royalton, VT 05068 (833)-795-5300 Support@Notices.LymeFiber.net Office hours: Monday &#8211; Friday, 9am-5pm</p>\n",
